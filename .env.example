# n8n Workflow 環境變數設定
# 複製此檔案為 .env 並填入實際值

# ==================== Slack API ====================
# Slack User Token (搜尋和讀取需要 user token)
SLACK_USER_TOKEN=xoxp-your-token-here

# ==================== Tableau API ====================
# Tableau Personal Access Token
TABLEAU_PAT_NAME=your-pat-name
TABLEAU_PAT_SECRET=your-pat-secret

# Tableau API 設定 (可選，已有預設值)
# TABLEAU_API_URL=https://prod-apnortheast-a.online.tableau.com
# TABLEAU_SITE_ID=your-site-id
# TABLEAU_VIEW_ID=your-view-id

# ==================== n8n API ====================
# n8n API Key (JWT Token)
N8N_API_KEY=your-n8n-api-key

# ==================== OpenAI API ====================
# OpenAI API Key (用於 AI 分析)
OPENAI_API_KEY=sk-your-openai-key
